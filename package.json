{
  "name": "@gmy/dsh-capability-router",
  "version": "0.1.0",
  "description": "Progressive tool discovery for DSH with scope-aware native dispatch and optional lazy MCP connections.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:runtime": "node --test test/runtime/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blankGMY/dsh-capability-router.git"
  },
  "dsh": {
    "engines": {
      "dsh": "0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
